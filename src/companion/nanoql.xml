<?xml version="1.0" encoding="utf-8"?>
<config name="NanoQL" version="1">
  <actions>
    <action name="init">
      <load file="nanoql.ini"/>
      <set id="R" value="1"/>
    </action>
    <action name="ready">
      <set id="R" value="0"/>
    </action>
    <action name="save">
      <save file="nanoql.ini"/>
    </action>
    <action name="reset">
      <set id="R" value="1"/>
      <delay ms="20"/>
      <set id="R" value="0"/>
      <hide/>
    </action>
    <action name="save_reset">
      <save file="nanoql.ini"/>
      <set id="R" value="1"/>
      <delay ms="20"/>
      <set id="R" value="0"/>
      <hide/>
    </action>
  </actions>
  <menu label="NanoQL v0.3.0">
    <menu label="System">
      <fileselector label="QL ROM:" ext="rom;bin" index="0" action="save_reset"/>
      <fileselector label="IPC ROM:" ext="hex;bin;rom" index="4" action="save_reset"/>
      <fileselector label="QSound ROM:" ext="rom;bin" index="3" default="QSound.rom" action="save_reset"/>
      <list label="RAM:" id="M" default="0" action="save_reset">
        <listentry label="128 KiB" value="0"/>
        <listentry label="640 KiB" value="1"/>
        <listentry label="896 KiB" value="2"/>
      </list>
      <list label="CPU:" id="C" default="0" action="save">
        <listentry label="QL" value="0"/>
        <listentry label="16 MHz" value="1"/>
        <listentry label="24 MHz" value="2"/>
      </list>
      <button label="Reset QL" action="reset"/>
    </menu>
    <menu label="Storage">
      <fileselector label="QL-SD image:" ext="win;qxl" index="1" action="save"/>
      <fileselector label="Microdrive 1:" ext="mdv" index="2" action="save"/>
      <fileselector label="Build MDV1:" ext="nqlfolder" index="7" default="/sd/NanoQL/Microdrives"/>
    </menu>
    <menu label="Display">
      <list label="Video mode:" id="A" default="0" action="save">
        <listentry label="50 Hz Sharp" value="0"/>
        <listentry label="50 Hz Large" value="1"/>
        <listentry label="50 Hz Fit" value="2"/>
        <listentry label="60 Hz Sharp" value="3"/>
        <listentry label="60 Hz Large" value="4"/>
        <listentry label="60 Hz Fit" value="5"/>
      </list>
    </menu>
    <menu label="Keyboard">
      <list label="USB keyboard:" id="H" default="0" action="save">
        <listentry label="QWERTY" value="0"/>
        <listentry label="AZERTY" value="1"/>
      </list>
      <list label="QL ROM keyboard:" id="K" default="0" action="save">
        <listentry label="English" value="0"/>
        <listentry label="French" value="1"/>
      </list>
    </menu>
  </menu>
</config>
