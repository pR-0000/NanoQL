<?xml version="1.0" encoding="utf-8"?>
<config name="NanoQL" version="0">
  <actions>
    <action name="init">
      <load file="nanoql.ini"/>
      <set id="R" value="1"/>
    </action>
    <action name="ready">
      <set id="R" value="0"/>
    </action>
    <action name="save">
      <save file="nanoql.ini"/>
    </action>
    <action name="reset">
      <set id="R" value="1"/>
      <delay ms="20"/>
      <set id="R" value="0"/>
      <hide/>
    </action>
    <action name="save_reset">
      <save file="nanoql.ini"/>
      <set id="R" value="1"/>
      <delay ms="20"/>
      <set id="R" value="0"/>
      <hide/>
    </action>
  </actions>
  <menu label="NanoQL">
    <fileselector label="QL ROM:" ext="rom;bin" index="0" default="QL.rom" action="save"/>
    <fileselector label="QL-SD image:" ext="win;qxl" index="1" action="save"/>
    <fileselector label="Microdrive 1:" ext="mdv" index="2" action="save"/>
    <fileselector label="Build MDV1 from:" ext="nqlfolder" index="7" default="/sd/NanoQL/Microdrives"/>
    <list label="Video:" id="A" default="0" action="save">
      <listentry label="Monitor" value="0"/>
      <listentry label="TV" value="1"/>
      <listentry label="Wide +6%" value="2"/>
      <listentry label="Wide +30%" value="3"/>
    </list>
    <list label="RAM:" id="M" default="0" action="save_reset">
      <listentry label="128 KiB" value="0"/>
      <listentry label="640 KiB" value="1"/>
      <listentry label="896 KiB" value="2"/>
    </list>
    <list label="CPU:" id="C" default="0" action="save">
      <listentry label="QL" value="0"/>
      <listentry label="16 MHz" value="1"/>
    </list>
    <button label="Reset QL" action="reset"/>
  </menu>
</config>
