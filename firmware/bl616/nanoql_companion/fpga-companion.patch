+bool mcu_hw_spi_begin_timeout(unsigned timeout_ms) {
+  if(xSemaphoreTake(spi_sem, pdMS_TO_TICKS(timeout_ms)) != pdTRUE)
+    return false;
+  bflb_gpio_reset(gpio, SPI_PIN_CSN);
