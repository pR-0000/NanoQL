 unsigned char mcu_hw_spi_tx_u08(unsigned char b) {
   return bflb_spi_poll_send(spi_dev, b);
 }
 
+bool mcu_hw_spi_tx_u08_timeout(unsigned char b, unsigned timeout_ms,
+                               unsigned char *received) {
+  uint32_t reg_base = spi_dev->reg_base;
+  uint64_t started = bflb_mtimer_get_time_us();
+
+  putreg32(b, reg_base + SPI_FIFO_WDATA_OFFSET);
+  for(;;) {
+    uint32_t fifo = getreg32(reg_base + SPI_FIFO_CONFIG_1_OFFSET);
+    if(((fifo & SPI_RX_FIFO_CNT_MASK) >> SPI_RX_FIFO_CNT_SHIFT) != 0)
+      break;
+    if(bflb_mtimer_get_time_us() - started >= (uint64_t)timeout_ms * 1000u) {
+      (void)bflb_spi_feature_control(spi_dev, SPI_CMD_CLEAR_TX_FIFO, 0);
+      (void)bflb_spi_feature_control(spi_dev, SPI_CMD_CLEAR_RX_FIFO, 0);
+      return false;
+    }
+  }
+
+  unsigned char value = (unsigned char)getreg32(
+      reg_base + SPI_FIFO_RDATA_OFFSET);
+  if(received)
+    *received = value;
+  return true;
+}
+
