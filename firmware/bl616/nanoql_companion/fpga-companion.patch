+static int sdc_quiesce_nanoql_microdrive(int drive) {
+  // Keep the old FIL alive while the FPGA observes the ejection and any
+  // translated request raised just before reset is completed.
+  sdc_image_inserted(drive, 0);
+  vTaskDelay(pdMS_TO_TICKS(20));
+
+  int quiet = 0;
+  for(int attempt=0; attempt<32 && quiet<4; attempt++) {
+    unsigned char request = sdc_pending_drive_requests();
+    if(request & (1u << drive)) {
+      (void)sdc_handle_event();
+      quiet = 0;
+    } else {
+      quiet++;
+    }
+    vTaskDelay(pdMS_TO_TICKS(2));
+  }
+
