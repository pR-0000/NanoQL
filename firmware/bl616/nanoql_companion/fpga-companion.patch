diff --git a/src/jtag.c b/src/jtag.c
index ff136f6..6ee5216 100644
--- a/src/jtag.c
+++ b/src/jtag.c
@@ -74,6 +74,20 @@ void jtag_shiftDR_part(uint8_t *tx, uint8_t *rx, uint16_t len, bool last) {
