+// GW2A command 0x16 exposes its external configuration Flash through a
+// special DR path entered from EXIT2-DR. The transition clock itself carries
+// no payload; data shifting starts once SHIFT-DR has been reached.
+void jtag_shiftDR_from_exit2(uint8_t *tx, uint8_t *rx, uint16_t len) {
+  mcu_hw_jtag_tms(1, 0, 1);  // EXIT2-DR -> SHIFT-DR
+  mcu_hw_jtag_data(tx, rx, len - 1);
+
+  uint8_t lrx = mcu_hw_jtag_tms(
+      tx ? ((tx[(len - 1) / 8] & 0x80) ? 1 : 0) : 1, 0b1, 1);
+  if(rx)
+    rx[(len - 1) / 8] = (rx[(len - 1) / 8] & 0x7f) | (lrx & 0x80);
+  mcu_hw_jtag_tms(1, 0b01, 2);
+}
