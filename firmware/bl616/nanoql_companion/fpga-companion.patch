index f2bbfd3..c4da798 100644
--- a/src/gowin.c
+++ b/src/gowin.c
@@ -16,6 +16,7 @@
 
 // idcode is stored globally so the FPGA routines can address the right FPGA
 static uint32_t idcode = 0;
+static bool gowin_stream_active = false;
 
 static void gowin_printStatusReg(uint32_t status) {
     if (status & GOWIN_STATUS_CRC_ERROR)            gowin_debugf("Bit 0: CRC ERROR detected");
@@ -252,6 +253,78 @@ static bool gowin_open(void) {
          idcode == IDCODE_GW5AST138);
 }
 
+bool gowin_stream_begin(void) {
+  if(gowin_stream_active)
+    gowin_stream_abort();
+
+  if(!gowin_open()) {
+    gowin_debugf("FPGA not detected");
+    jtag_close();
+    return false;
+  }
+
+  if(!gowin_eraseSRAM()) {
+    gowin_debugf("Failed to erase SRAM");
+    jtag_close();
+    return false;
+  }
+
+  if(idcode == IDCODE_GW5AST138 && !gowin_eraseSRAM()) {
+    gowin_debugf("Failed to erase SRAM a second time");
+    jtag_close();
+    return false;
+  }
+
+  gowin_writeSRAM_prepare();
+#ifdef MCU_HW_JTAG_GPIO_OUT_MODE
+  mcu_hw_jtag_enter_gpio_out_mode();
+#endif
+  gowin_stream_active = true;
+  return true;
+}
+
+bool gowin_stream_data(const uint8_t *data, uint16_t length, bool last) {
+  if(!gowin_stream_active || !data || !length)
+    return false;
+
+#ifndef MCU_HW_JTAG_GPIO_OUT_MODE
+  uint8_t buffer[length];
+  memcpy(buffer, data, length);
+  for(uint16_t i=0;i<length;i++) buffer[i] = reverse_byte(buffer[i]);
+  gowin_writeSRAM_transfer(buffer, length, last);
+#else
+  mcu_hw_jtag_writeTDI_msb_first_gpio_out_mode((uint8_t *)data, length, last);
+#endif
+  return true;
+}
+
+static void gowin_stream_leave_shift(void) {
+#ifdef MCU_HW_JTAG_GPIO_OUT_MODE
+  mcu_hw_jtag_exit_gpio_out_mode();
+  mcu_hw_jtag_tms(1, 0b01, 2);
+#endif
+}
+
+bool gowin_stream_end(void) {
+  if(!gowin_stream_active)
+    return false;
+
+  gowin_stream_leave_shift();
+  bool success = gowin_writeSRAM_postproc(0xffffffff);
+  jtag_close();
+  gowin_stream_active = false;
+  return success;
+}
+
+void gowin_stream_abort(void) {
+  if(!gowin_stream_active)
+    return;
+
+  gowin_stream_leave_shift();
+  jtag_close();
+  gowin_stream_active = false;
+}
