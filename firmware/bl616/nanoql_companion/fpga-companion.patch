+// The GW2AR-18 uses the Tang Nano 20K's external 64-Mbit SPI Flash for
+// persistent configuration. Command 0x16 bridges JTAG to the MSPI pins. The
+// transfer and read-bit alignment follow Gowin UG290 and openFPGALoader.
+#define GOWIN_SPI_MAX_TRANSFER 262
+#define SPI_FLASH_READ         0x03
+#define SPI_FLASH_PAGE_PROGRAM 0x02
+#define SPI_FLASH_READ_STATUS  0x05
+#define SPI_FLASH_WRITE_ENABLE 0x06
+#define SPI_FLASH_SECTOR_ERASE 0x20
+#define SPI_FLASH_READ_ID      0x9f
+#define SPI_FLASH_RESET_ENABLE 0x66
+#define SPI_FLASH_RESET        0x99
+#define SPI_FLASH_POWER_UP     0xab
+
+static uint32_t gowin_flash_size;
+
+static bool gowin_spi_transfer(const uint8_t *tx, uint8_t *rx,
+                               uint16_t length) {
+  if(!tx || !length || length + (rx ? 1 : 0) > GOWIN_SPI_MAX_TRANSFER)
+    return false;
+
+  uint8_t wire_tx[GOWIN_SPI_MAX_TRANSFER];
+  uint8_t wire_rx[GOWIN_SPI_MAX_TRANSFER];
+  uint16_t wire_length = length + (rx ? 1 : 0);
+  memset(wire_tx, 0, wire_length);
+  memset(wire_rx, 0, wire_length);
+  for(uint16_t i = 0; i < length; ++i)
+    wire_tx[i] = reverse_byte(tx[i]);
+
+  jtag_command_u08(GOWIN_COMMAND_TRANSFER_SPI);
+  // RUN-TEST/IDLE -> SELECT-DR -> CAPTURE-DR -> EXIT1-DR -> PAUSE-DR
+  // -> EXIT2-DR. Bits are sent least-significant first by this helper.
+  mcu_hw_jtag_tms(1, 0b10101, 5);
+  jtag_shiftDR_from_exit2(wire_tx, rx ? wire_rx : NULL,
+                          wire_length * 8);
+
+  if(rx) {
+    for(uint16_t i = 0; i < length; ++i)
+      rx[i] = reverse_byte(wire_rx[i] >> 1) | (wire_rx[i + 1] & 1);
+  }
+  return true;
+}
+
+static bool gowin_spi_command(uint8_t command) {
+  return gowin_spi_transfer(&command, NULL, 1);
+}
+
+static bool gowin_flash_read_status(uint8_t *status) {
+  uint8_t tx[2] = { SPI_FLASH_READ_STATUS, 0 };
+  uint8_t rx[2];
+  if(!gowin_spi_transfer(tx, rx, sizeof(tx)))
+    return false;
+  *status = rx[1];
+  return true;
+}
+
+static bool gowin_flash_wait_ready(uint32_t timeout_ms) {
+  vTaskDelay(pdMS_TO_TICKS(2));
+  for(uint32_t elapsed = 0; elapsed < timeout_ms; ++elapsed) {
+    uint8_t status;
+    if(!gowin_flash_read_status(&status))
+      return false;
+    if((status & 1) == 0)
+      return true;
+    vTaskDelay(pdMS_TO_TICKS(1));
+  }
+  gowin_debugf("SPI Flash busy timeout");
+  return false;
+}
+
+static bool gowin_flash_write_enable(void) {
+  if(!gowin_spi_command(SPI_FLASH_WRITE_ENABLE))
+    return false;
+  uint8_t status;
+  return gowin_flash_read_status(&status) && (status & 2) != 0;
+}
+
+static bool gowin_flash_erase_sector(uint32_t address) {
+  uint8_t command[4] = {
+    SPI_FLASH_SECTOR_ERASE,
+    (uint8_t)(address >> 16),
+    (uint8_t)(address >> 8),
+    (uint8_t)address
+  };
+  return gowin_flash_write_enable() &&
+         gowin_spi_transfer(command, NULL, sizeof(command)) &&
+         gowin_flash_wait_ready(5000);
+}
+
+static bool gowin_flash_read(uint32_t address, uint8_t *data,
+                             uint16_t length) {
+  uint8_t tx[260];
+  uint8_t rx[260];
+  uint16_t transfer_length = length + 4;
+  if(!data || length > 256)
+    return false;
+  memset(tx, 0, transfer_length);
+  tx[0] = SPI_FLASH_READ;
+  tx[1] = (uint8_t)(address >> 16);
+  tx[2] = (uint8_t)(address >> 8);
+  tx[3] = (uint8_t)address;
+  if(!gowin_spi_transfer(tx, rx, transfer_length))
+    return false;
+  memcpy(data, &rx[4], length);
+  return true;
+}
+
+static bool gowin_writeFLASH_page(void) {
+  uint32_t address = gowin_flash_page_index * sizeof(gowin_flash_page);
+  uint8_t command[260];
+  uint8_t verify[sizeof(gowin_flash_page)];
+
+  if((address & 0xfff) == 0 && !gowin_flash_erase_sector(address)) {
+    gowin_debugf("SPI Flash erase failed at 0x%08lx", address);
+    return false;
+  }
+
+  command[0] = SPI_FLASH_PAGE_PROGRAM;
+  command[1] = (uint8_t)(address >> 16);
+  command[2] = (uint8_t)(address >> 8);
+  command[3] = (uint8_t)address;
+  memcpy(&command[4], gowin_flash_page, sizeof(gowin_flash_page));
+  if(!gowin_flash_write_enable() ||
+     !gowin_spi_transfer(command, NULL, sizeof(command)) ||
+     !gowin_flash_wait_ready(1000) ||
+     !gowin_flash_read(address, verify, sizeof(verify)) ||
+     memcmp(verify, gowin_flash_page, sizeof(verify)) != 0) {
+    gowin_debugf("SPI Flash program/verify failed at 0x%08lx", address);
+    return false;
+  }
+
+  gowin_flash_page_index++;
+  gowin_flash_page_used = 0;
+  memset(gowin_flash_page, 0xff, sizeof(gowin_flash_page));
+  return true;
+}
+
+bool gowin_flash_stream_begin(uint32_t image_size) {
+  if(gowin_flash_stream_active)
+    gowin_flash_stream_abort();
+
+  if(!image_size || !gowin_open() || idcode != IDCODE_GW2AR18) {
+    gowin_debugf("GW2AR-18 FPGA not detected");
+    jtag_close();
+    return false;
+  }
+  if(!gowin_eraseSRAM()) {
+    gowin_debugf("Failed to prepare GW2AR external Flash access");
+    jtag_close();
+    return false;
+  }
+
+  if(!gowin_spi_command(SPI_FLASH_RESET_ENABLE) ||
+     !gowin_spi_command(SPI_FLASH_RESET)) {
+    jtag_close();
+    return false;
+  }
+  vTaskDelay(pdMS_TO_TICKS(2));
+  if(!gowin_spi_command(SPI_FLASH_POWER_UP)) {
+    jtag_close();
+    return false;
+  }
+
+  uint8_t id_tx[4] = { SPI_FLASH_READ_ID, 0, 0, 0 };
+  uint8_t id_rx[4];
+  if(!gowin_spi_transfer(id_tx, id_rx, sizeof(id_tx))) {
+    jtag_close();
+    return false;
+  }
+  uint32_t jedec = ((uint32_t)id_rx[1] << 16) |
+                   ((uint32_t)id_rx[2] << 8) | id_rx[3];
+  if(jedec == 0 || jedec == 0xffffff ||
+     id_rx[3] < 20 || id_rx[3] > 24) {
+    gowin_debugf("Invalid SPI Flash JEDEC ID: 0x%06lx", jedec);
+    jtag_close();
+    return false;
+  }
+  gowin_flash_size = UINT32_C(1) << id_rx[3];
+  if(image_size > gowin_flash_size) {
+    gowin_debugf("FPGA image is larger than SPI Flash");
+    jtag_close();
+    return false;
+  }
+  gowin_debugf("SPI Flash detected: 0x%06lx, %lu bytes", jedec,
+               (unsigned long)gowin_flash_size);
+
+  memset(gowin_flash_page, 0xff, sizeof(gowin_flash_page));
+  gowin_flash_page_used = 0;
+  gowin_flash_page_index = 0;
+  gowin_flash_stream_active = true;
+  return true;
+}
+
+bool gowin_flash_stream_data(const uint8_t *data, uint16_t length) {
+  if(!gowin_flash_stream_active || !data || !length)
+    return false;
+
+  while(length != 0) {
+    uint16_t available = sizeof(gowin_flash_page) - gowin_flash_page_used;
+    uint16_t count = length < available ? length : available;
+    memcpy(&gowin_flash_page[gowin_flash_page_used], data, count);
+    gowin_flash_page_used += count;
+    data += count;
+    length -= count;
+    if(gowin_flash_page_used == sizeof(gowin_flash_page) &&
+       !gowin_writeFLASH_page())
+      return false;
+  }
+  return true;
+}
+
+bool gowin_flash_stream_end(void) {
+  if(!gowin_flash_stream_active)
+    return false;
+
+  bool success = gowin_flash_page_used == 0 || gowin_writeFLASH_page();
+  if(success) {
+    jtag_command_u08(GOWIN_COMMAND_RECONFIG);
+    jtag_command_u08(GOWIN_COMMAND_NOOP);
+    jtag_clk_us(600000);
+  }
+  jtag_close();
+  gowin_flash_stream_active = false;
+  return success;
+}
+
+void gowin_flash_stream_abort(void) {
+  if(!gowin_flash_stream_active)
+    return;
+  jtag_close();
+  gowin_flash_stream_active = false;
+}
