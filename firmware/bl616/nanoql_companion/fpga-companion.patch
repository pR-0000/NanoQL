+#ifdef NANOQL_COMPANION
+#define INIFILE_ASYNC_NAME_LENGTH 64
+
+typedef struct {
+  char name[INIFILE_ASYNC_NAME_LENGTH];
+} inifile_async_request_t;
+
+static QueueHandle_t inifile_async_queue;
+static TaskHandle_t inifile_async_task_handle;
+
+static void inifile_async_task(void *parameter) {
+  (void)parameter;
+  inifile_async_request_t request;
+
+  for(;;) {
+    if(xQueueReceive(inifile_async_queue, &request, portMAX_DELAY) == pdTRUE) {
+      // Keep only the latest menu state if several key presses arrived while
+      // the card was busy. The synchronous writer takes the filesystem lock.
+      inifile_async_request_t newer;
+      while(xQueueReceive(inifile_async_queue, &newer, 0) == pdTRUE)
+        request = newer;
+      inifile_write(request.name);
+    }
+  }
+}
+
+void inifile_write_async(const char *name) {
+  if(!name || strlen(name) >= INIFILE_ASYNC_NAME_LENGTH) {
+    ini_debugf("Unable to queue settings write");
+    return;
+  }
+
+  if(!inifile_async_queue) {
+    inifile_async_queue = xQueueCreate(1, sizeof(inifile_async_request_t));
+    if(!inifile_async_queue ||
+       xTaskCreate(inifile_async_task, "INI save", 2048, NULL,
+                   configMAX_PRIORITIES - 5,
+                   &inifile_async_task_handle) != pdPASS) {
+      if(inifile_async_queue) {
+        vQueueDelete(inifile_async_queue);
+        inifile_async_queue = NULL;
+      }
+      inifile_async_task_handle = NULL;
+      ini_debugf("Unable to start settings writer");
+      return;
+    }
+  }
+
+  inifile_async_request_t request;
+  strcpy(request.name, name);
+  (void)xQueueOverwrite(inifile_async_queue, &request);
+}
+#endif
