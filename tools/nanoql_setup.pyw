        self._update_cpu_control_buttons()

    def _update_cpu_control_buttons(self) -> None:
        if not hasattr(self, "halt_cpu_button"):
            return
        if self.operation_busy:
            halt_state = resume_state = "disabled"
        elif self.cpu_halted is True:
            halt_state, resume_state = "disabled", "normal"
        elif self.cpu_halted is False:
            halt_state, resume_state = "normal", "disabled"
        else:
            halt_state = resume_state = "normal"
        self.halt_cpu_button.configure(state=halt_state)
        self.resume_cpu_button.configure(state=resume_state)

