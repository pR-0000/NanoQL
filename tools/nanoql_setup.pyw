    def capture_screenshot(self) -> None:
        folder = self.screenshot_folder.get().strip()
        if not folder:
            self._browse_screenshot_folder()
            folder = self.screenshot_folder.get().strip()
            if not folder:
                return
        self.log.focus_set()
        if self._keyboard_active():
            self._request_keyboard_operation({
                "command": "screenshot",
                "destination": str(Path(folder).expanduser().resolve()),
            }, "Capturing QL screen")
        else:
            command = self._link_command("screenshot")
            command.append(folder)
            self._run(command, "Capturing QL screen")

