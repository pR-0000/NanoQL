        asm_horizontal.grid(row=2, column=1, sticky="ew", padx=(8, 0))

        def scroll_both(*args) -> None:
            self.debug_raw.yview(*args)
            self.debug_asm.yview(*args)

        self._debug_scroll_syncing = False

        def synchronize_scroll(source, peer, first, last) -> None:
            scrollbar.set(first, last)
            if self._debug_scroll_syncing:
                return
            self._debug_scroll_syncing = True
            try:
                peer.yview_moveto(float(first))
            finally:
                self._debug_scroll_syncing = False

        scrollbar.configure(command=scroll_both)
        self.debug_raw.configure(
            yscrollcommand=lambda first, last: synchronize_scroll(
