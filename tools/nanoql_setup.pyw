        if bitstream is None or not self._require_nanoql_link():
            return
        command = self._link_command("fpga-flash")
        command.extend([str(bitstream), "--yes"])
        self._run(
            command,
            "Programming FPGA Flash through NanoQL Link",
            lambda: self._mark_workflow("fpga"),
